# Copiar a ".env" y completar. El archivo ".env" NO se sube al repositorio.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
ADMIN_URL=admin/
DOCS_API_HABILITADA=True
LOG_LEVEL=INFO
LOG_JSON=False

# --- PostgreSQL ---
DB_NAME=tienda
DB_USER=postgres
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# --- Redis (apagado en desarrollo local; en el VPS: USAR_REDIS=True) ---
USAR_REDIS=False
# Sin número de base. Se usan: 0 caché, 1 Celery, 2 throttling.
REDIS_URL=redis://localhost:6379
CELERY_TASK_ALWAYS_EAGER=True

# --- CORS (frontend React) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Límites de tasa ---
THROTTLE_LOGIN=5/min
THROTTLE_USUARIO=120/min
THROTTLE_ANON=30/min

# --- Cifrado de credenciales SUNAT (claves Fernet versionadas) ---
# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Formato: version:clave,version:clave   (la actual cifra; todas descifran)
CIFRADO_CLAVES=1:cambiar-por-clave-fernet
CIFRADO_CLAVE_ACTUAL=1

# --- Correo saliente y enlaces (recuperación de contraseña) ---
FRONTEND_URL=http://localhost:5173
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Sistema Unificado <no-responder@localhost>

# --- Retención ---
AUDITORIA_RETENCION_DIAS=730
SESIONES_RETENCION_DIAS=90

# Consulta de DNI (RENIEC) y RUC (SUNAT): token de https://decolecta.com/profile
DECOLECTA_TOKEN=
# DECOLECTA_URL=https://api.decolecta.com
# Cuota del plan (el gratuito trae 100 consultas al mes); el sistema se detiene al llegar.
# DECOLECTA_LIMITE_MENSUAL=100
# Tipo de cambio automático (gasta cuota; apagado por defecto). Solo SUNAT = 26 consultas al mes.
# TIPO_CAMBIO_AUTOMATICO=False
# TIPO_CAMBIO_FUENTES_AUTOMATICAS=SUNAT
# TIPO_CAMBIO_UMBRAL_AUTOMATICO=0.6
# THROTTLE_CONSULTAS=20/min

# Facturación electrónica (API propia). Las claves SOL de cada empresa NO van aquí: se registran cifradas en el sistema.
SUNAT_API_URL=http://localhost/API_SUNAT/
SUNAT_API_TIMEOUT=30
# Archivo de la guía de remisión dentro de la API (se deja vacío hasta confirmarlo)
SUNAT_ENDPOINT_GUIA=
