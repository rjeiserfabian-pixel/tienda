# Dirección de la API del sistema (el servidor de la tienda la consulta; el navegador nunca la ve).
API_URL=http://localhost:8000

# Dirección pública de la tienda (para el mapa del sitio y los enlaces compartidos).
SITE_URL=http://localhost:3000

# El logo, el WhatsApp, el contacto, los colores y los textos de la tienda se administran en el panel
# (Tienda virtual → Configuración); no se escriben aquí.

# Secreto con el que el servidor del sistema avisa que algo cambió (la tienda se renueva al instante).
# Debe ser igual a TIENDA_RENOVAR_TOKEN del servidor. Vacío = se renueva sola por tiempo.
RENOVAR_TOKEN=
